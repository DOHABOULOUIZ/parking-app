                        <div className="stat-details" style={{ display: 'flex', gap: '0.5rem', flexWrap: 'wrap' }}>
                            <span className="badge-count" style={{ background: '#d1fae5', color: '#065f46' }}>
                                {stats.places.available} libres
                            </span>
                            <span className="badge-count" style={{ background: '#fee2e2', color: '#991b1b' }}>
                                {stats.places.occupied} occupées
                            </span>
                            <span className="badge-count" style={{ background: '#fef3c7', color: '#92400e' }}>
                                {stats.places.reserved} réservées
                            </span>
                        </div>
                    </div>
                </div>

                {/* Sectors Card */}
                <div className="stat-card-modern" style={{ '--stat-color': '#8b5cf6' }}>
