                    <div className="stat-content">
                        <div className="stat-label">Secteurs</div>
                        <div className="stat-value">{stats.sectors.total}</div>
                    </div>
                </div>

                {/* Reservations Card */}
                <div className="stat-card-modern" style={{ '--stat-color': '#ef4444' }}>
                    <div className="stat-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <div className="stat-content">
                        <div className="stat-label">Réservations</div>
                        <div className="stat-value">{stats.reservations.total}</div>
                        <div className="stat-details" style={{ display: 'flex', gap: '0.5rem', flexWrap: 'wrap' }}>
                            <span className="badge-count" style={{ background: '#dbeafe', color: '#1e40af' }}>
                                {stats.reservations.ongoing} en cours
                            </span>
                            <span className="badge-count" style={{ background: '#d1fae5', color: '#065f46' }}>
                                {stats.reservations.completed} terminées
                            </span>
                        </div>
                    </div>
                </div>

                {/* Revenue Card */}
                <div className="stat-card-modern" style={{ '--stat-color': '#10b981' }}>
                    <div className="stat-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <div className="stat-content">
                        <div className="stat-label">Revenus</div>
                        <div className="stat-value">{parseFloat(stats.revenue.total || 0).toFixed(2)} MAD</div>
                        <div className="stat-details">
                            En attente : {parseFloat(stats.revenue.pending || 0).toFixed(2)} MAD
                        </div>
                    </div>
                </div>
            </div>

            {/* Quick Links */}
            <div className="table-card-modern" style={{ marginBottom: '2rem' }}>
                <div className="table-header">
                    <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 600 }}>Accès Rapide</h3>
                </div>
                <div style={{ padding: '1.25rem' }}>
                    <div style={{ 
                        display: 'grid', 
                        gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))', 
                        gap: '1rem' 
                    }}>
                        {quickLinks.map(link => (
                            <NavLink 
                                key={link.to}
                                to={link.to}
                                style={{
                                    display: 'flex',
                                    alignItems: 'center',
                                    gap: '0.75rem',
                                    padding: '0.875rem 1rem',
                                    textDecoration: 'none',
                                    color: '#475569',
                                    background: '#f8fafc',
                                    border: '1px solid #e2e8f0',
                                    borderRadius: '8px',
                                    transition: 'all 0.15s ease',
                                    fontSize: '0.875rem',
                                    fontWeight: 500
                                }}
                                className="quick-link-hover"
                            >
                                <QuickLinkIcon icon={link.icon} />
                                {link.label}
                            </NavLink>
                        ))}
                    </div>
                </div>
            </div>

            {/* QR Scanner Card */}
            <div 
                className="table-card-modern"
                style={{
                    background: 'linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)',
                    border: 'none'
                }}
            >
                <div style={{ 
                    padding: '1.25rem',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'space-between',
                    flexWrap: 'wrap',
                    gap: '1rem'
                }}>
                    <div>
                        <h3 style={{ margin: '0 0 0.5rem 0', color: 'white', fontSize: '1.125rem', fontWeight: 600 }}>
                            Scanner QR Code
                        </h3>
                        <p style={{ margin: 0, color: 'rgba(255,255,255,0.9)', fontSize: '0.875rem' }}>
                            Effectuez le check-in/check-out des réservations
                        </p>
                    </div>
                    <NavLink 
                        to="/admin/qr-scanner"
                        className="btn-modern btn-secondary"
                        style={{
                            background: 'white',
                            color: '#3b82f6',
                            border: '1px solid white',
                            whiteSpace: 'nowrap'
                        }}
                    >
                        Ouvrir Scanner →
                    </NavLink>
                </div>
            </div>
        </div>
    );
}
